# ==============================================================================
# Folio Environment Configuration Matrix
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Application Runtime & Environment
# ------------------------------------------------------------------------------
# Options: development | test | staging | production
APP_ENV=development

# Application Secret Key (Used for cryptographic HMAC and session generation)
# IN PRODUCTION: MUST be at least 32 characters long with high entropy.
# Startup validation FAILS FAST if APP_ENV=production and secret is weak or default.
APP_SECRET=folio_dev_insecure_secret_key_change_in_production_32bytes_min

PORT=8000
HOST=127.0.0.1

# ------------------------------------------------------------------------------
# 2. Database Connectivity
# ------------------------------------------------------------------------------
# Primary application PostgreSQL database
# In production, default 'postgres:postgres' credentials are blocked at startup.
DATABASE_URL=postgresql+psycopg://postgres@127.0.0.1:5432/folio

# Dedicated test database (used by pytest test suites)
TEST_DATABASE_URL=postgresql+psycopg://postgres@127.0.0.1:5432/folio_test

# ------------------------------------------------------------------------------
# 3. Security, Cookies & HTTPS
# ------------------------------------------------------------------------------
# Enforces 'Secure' flag on session cookies and enables HSTS header.
# MUST be set to true in production over HTTPS. Startup validation fails fast if false in production.
COOKIE_SECURE=false

# SameSite cookie policy: lax | strict | none (none requires COOKIE_SECURE=true)
COOKIE_SAMESITE=lax

# ------------------------------------------------------------------------------
# 4. CORS & Trusted Reverse Proxies
# ------------------------------------------------------------------------------
# Comma-separated allowed origins for cross-origin credentials.
# Wildcard '*' is strictly forbidden when credentials are enabled.
# Examples:
#   Development: http://localhost:8000,http://127.0.0.1:8000,http://localhost:3000
#   Production:  https://folio.example.com
CORS_ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,http://localhost:3000,http://127.0.0.1:3000

# Trusted reverse proxy IPs (for client IP extraction via X-Forwarded-For)
TRUSTED_PROXIES=127.0.0.1,::1

# ------------------------------------------------------------------------------
# 5. Rate Limiting Protection
# ------------------------------------------------------------------------------
# Sliding window abuse defense for login and registration
RATE_LIMIT_ENABLED=true
RATE_LIMIT_LOGIN_MAX_FAILED=5
RATE_LIMIT_LOGIN_WINDOW_SECONDS=60
RATE_LIMIT_REGISTER_MAX=10
RATE_LIMIT_REGISTER_WINDOW_SECONDS=60

# ------------------------------------------------------------------------------
# 6. Initial Admin Provisioning (Production)
# ------------------------------------------------------------------------------
# In production, demo accounts are never seeded.
# To provision or rotate the initial Super Admin, use:
#   python scripts/bootstrap_admin.py --rotate
# Or set these environment variables:
#   ADMIN_BOOTSTRAP_EMAIL=admin@yourdomain.com
#   ADMIN_BOOTSTRAP_USERNAME=admin
#   ADMIN_BOOTSTRAP_PASSWORD=YourStrongPasswordHere!

# ------------------------------------------------------------------------------
# 7. Development & Demo Flags
# ------------------------------------------------------------------------------
# Feature flag for legacy semantic search endpoint (/search)
ENABLE_LEGACY_SEARCH=false

# BM25: filesystem for local workers; database for shared serverless generations.
# Vercel selects database automatically. Override only when changing deployment storage.
# INDEX_STORAGE_BACKEND=filesystem

# Default password for local demo accounts in development (IGNORED in production)
DEMO_PASSWORD=FolioDemo2026!
