# Folio Environment Configuration

# Application settings
APP_ENV=development
APP_SECRET=folio_dev_insecure_secret_key_change_in_production_32bytes_min
PORT=8000
HOST=127.0.0.1

# Database settings
# For Docker Compose: postgresql+psycopg://postgres:postgres@localhost:5432/folio
# For local PostgreSQL:
DATABASE_URL=postgresql+psycopg://postgres@127.0.0.1:5432/folio
TEST_DATABASE_URL=postgresql+psycopg://postgres@127.0.0.1:5432/folio_test

# Cookie security (set to true in production over HTTPS)
COOKIE_SECURE=false

# Legacy Search Engine Feature Flag (Phase 2 legacy demo)
ENABLE_LEGACY_SEARCH=false

# Local demo account password for seed script
DEMO_PASSWORD=FolioDemo2026!
