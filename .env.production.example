# ==============================================================================
# Folio Production / Staging Environment Configuration Template
# Copy to .env.production on staging or production host.
# NEVER commit populated .env.production to version control!
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Environment & Secrets
# ------------------------------------------------------------------------------
# Target environment tier: staging | production
APP_ENV=production

# Application Secret Key: MUST be >= 32 characters, high entropy.
# Startup validation will FAIL FAST if weak or default.
# Generate via: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
APP_SECRET=replace_with_a_secure_random_64_character_hex_string_in_production_12345

# Domain configuration (used by reverse proxy and CORS)
DOMAIN_NAME=folio.example.com
STAGING_DOMAIN=staging.folio.example.com

# ------------------------------------------------------------------------------
# 2. Database Connectivity (Internal Docker Network)
# ------------------------------------------------------------------------------
POSTGRES_DB=folio
POSTGRES_USER=folio_prod_user
# Strong database password (do NOT use 'postgres')
POSTGRES_PASSWORD=replace_with_strong_database_password_12345

# Application connection string (references internal service 'db')
DATABASE_URL=postgresql+psycopg://folio_prod_user:replace_with_strong_database_password_12345@db:5432/folio

# ------------------------------------------------------------------------------
# 3. Security, Cookies & Reverse Proxy
# ------------------------------------------------------------------------------
# Enforces 'Secure' flag on cookies. MUST be true in production HTTPS!
COOKIE_SECURE=true
COOKIE_SAMESITE=lax

# Allowed CORS Origins (comma-separated, NO wildcard '*')
CORS_ALLOWED_ORIGINS=https://folio.example.com,https://staging.folio.example.com

# Reverse proxy trusted CIDRs/IPs (Nginx/Caddy container IP in Docker network)
TRUSTED_PROXIES=127.0.0.1,::1,172.16.0.0/12,10.0.0.0/8

# Proxy ports on the host
PROXY_HTTP_PORT=80
PROXY_HTTPS_PORT=443

# Reverse proxy HSTS configuration (active in production with verified SSL)
HSTS_HEADER=add_header Strict-Transport-Security "max-age=31536000; includeSubDomains; preload" always;

# ------------------------------------------------------------------------------
# 4. Storage & Persistence
# ------------------------------------------------------------------------------
INDEX_STORAGE_DIR=/app/data/search_index/generations

# ------------------------------------------------------------------------------
# 5. Worker Configuration
# ------------------------------------------------------------------------------
WORKER_POLL_INTERVAL=1.0
WORKER_BATCH_SIZE=10

# ------------------------------------------------------------------------------
# 6. Semantic Backend Profile (Optional)
# ------------------------------------------------------------------------------
# Set to true to enable legacy / optional semantic vector search
ENABLE_LEGACY_SEARCH=false
CHROMA_PATH=/app/data/vector
CHROMA_COLLECTION_NAME=wiki_ai_english
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2

# ------------------------------------------------------------------------------
# 7. Initial Super Admin Bootstrap (Run Once During Rollout)
# ------------------------------------------------------------------------------
ADMIN_BOOTSTRAP_EMAIL=admin@folio.example.com
ADMIN_BOOTSTRAP_USERNAME=superadmin
ADMIN_BOOTSTRAP_PASSWORD=replace_with_strong_initial_admin_password_12345
