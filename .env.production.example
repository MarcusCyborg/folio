# ==============================================================================
# Folio Production / Staging Environment Configuration Template
# Copy to .env.production on staging or production host.
# Invoke Docker Compose with:
#   docker compose --env-file .env.production -f docker-compose.prod.yml <cmd>
# NEVER commit populated .env.production or .env.restored to version control!
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Environment & Secrets
# ------------------------------------------------------------------------------
# Target environment tier: staging | production
APP_ENV=production

# Application Secret Key: REQUIRED (MUST be >= 32 characters, >= 10 distinct characters).
# Compose and startup validation FAIL FAST if empty, weak, or placeholder.
# Generate via: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# Note: avoid unescaped '$' characters in Compose env files (or double them '$$').
APP_SECRET=

# Domain configuration (used by reverse proxy, TLS validation, and CORS)
DOMAIN_NAME=folio.example.com
STAGING_DOMAIN=staging.folio.example.com
# Optional explicit expected SAN/CN for proxy TLS preflight (defaults to DOMAIN_NAME)
CERT_EXPECTED_DOMAIN=

# ------------------------------------------------------------------------------
# 2. Database Connectivity (Internal Docker Network)
# ------------------------------------------------------------------------------
POSTGRES_DB=folio
POSTGRES_USER=folio_prod_user
# Strong database password (REQUIRED, non-empty; do NOT use 'postgres';
# prefer URL-safe characters or URL-encode special characters in explicit DATABASE_URL)
POSTGRES_PASSWORD=

# Optional explicit DATABASE_URL override:
# - Leave empty in Docker Compose to derive automatically from POSTGRES_* against '@db:5432'.
# - Set explicitly during restore cutover (e.g. postgresql+psycopg://.../folio_restored_<ts>),
#   external managed PostgreSQL, or Vercel serverless.
# - NEVER use '@db:5432' from host Python CLI outside Docker network!
DATABASE_URL=

# ------------------------------------------------------------------------------
# 3. Security, Cookies & Reverse Proxy
# ------------------------------------------------------------------------------
# Enforces 'Secure' flag on cookies. MUST be true in production HTTPS!
COOKIE_SECURE=true
COOKIE_SAMESITE=lax

# Allowed CORS Origins (comma-separated, NO wildcard '*')
CORS_ALLOWED_ORIGINS=https://folio.example.com,https://staging.folio.example.com

# Reverse proxy trusted CIDRs/IPs (Nginx/Caddy container IP in Docker network)
TRUSTED_PROXIES=127.0.0.1,::1,172.16.0.0/12,10.0.0.0/8

# Proxy ports on the host
PROXY_HTTP_PORT=80
PROXY_HTTPS_PORT=443

# Reverse proxy HSTS configuration:
# - Production with trusted CA HTTPS: enable HSTS line below
# - Local/Staging self-signed TLS: comment out or set '# HSTS disabled in staging'
# Note: keep single quotes around values containing spaces/quotes/semicolons for POSIX Bash & Compose compatibility.
HSTS_HEADER='add_header Strict-Transport-Security "max-age=31536000; includeSubDomains; preload" always;'

# Rate limiting & bounded search concurrency
RATE_LIMIT_ENABLED=true
SEARCH_CONTEXT_TTL_MINUTES=15
SEARCH_TIMEOUT_SECONDS=5.0
SEMANTIC_EXECUTOR_WORKERS=2
SEMANTIC_MAX_PENDING=2

# ------------------------------------------------------------------------------
# 4. Storage, Persistence & Cutover Volume Names
# ------------------------------------------------------------------------------
# Stable in-container paths (keep aligned with Dockerfile ENV & Compose mounts)
INDEX_STORAGE_DIR=/app/data/search_index/generations
MEDIA_DIR=/app/data/media
ENABLE_LEGACY_SEARCH=false

# Named Docker volume identifiers (change FOLIO_INDEX_VOLUME / FOLIO_MEDIA_VOLUME
# during non-destructive restore cutover while keeping original volumes intact)
FOLIO_PGDATA_VOLUME=folio-pgdata
FOLIO_INDEX_VOLUME=folio-index-data
FOLIO_MEDIA_VOLUME=folio-media-data
FOLIO_CHROMA_VOLUME=folio-chroma-data
FOLIO_CERTS_VOLUME=folio-proxy-certs

# ------------------------------------------------------------------------------
# 5. Worker Configuration
# ------------------------------------------------------------------------------
WORKER_POLL_INTERVAL=1.0
WORKER_BATCH_SIZE=10

# ------------------------------------------------------------------------------
# 6. Semantic Backend Profile (Optional: --profile semantic)
# ------------------------------------------------------------------------------
CHROMA_PATH=/app/data/vector
# Set CHROMA_HOST=chroma when running with '--profile semantic'
CHROMA_HOST=
CHROMA_PORT=8000
CHROMA_COLLECTION_NAME=wiki_ai_english
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2

# ------------------------------------------------------------------------------
# 7. Initial Super Admin Bootstrap (Set Only When Provisioning / Rotating)
# ------------------------------------------------------------------------------
ADMIN_BOOTSTRAP_EMAIL=admin@folio.example.com
ADMIN_BOOTSTRAP_USERNAME=superadmin
ADMIN_BOOTSTRAP_DISPLAY_NAME='Super Administrator'
# Leave blank by default; supply >= 12-char strong password only when running bootstrap/rotate
ADMIN_BOOTSTRAP_PASSWORD=
